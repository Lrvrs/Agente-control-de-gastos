# PLANTILLA de secretos. Copiar el contenido en el panel de
# Streamlit Community Cloud: Settings > Secrets.
#
# El diseno es deliberadamente agnostico del proveedor: cualquier servicio que
# exponga una API compatible con OpenAI funciona cambiando solo estas cadenas,
# sin tocar una linea de codigo.
#
# Groq        -> https://api.groq.com/openai/v1
# Gemini      -> https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter  -> https://openrouter.ai/api/v1

[llm]
clave_api = "PEGAR_AQUI_LA_CLAVE"
url_base = "https://api.groq.com/openai/v1"
modelo = "openai/gpt-oss-120b"

# Alternativa agentica: groq/compound es un sistema que incorpora busqueda
# web, visita de paginas, ejecucion de codigo y Wolfram Alpha del lado del
# servidor. Cambiando unicamente esta linea, el agente deja de responder de
# memoria y pasa a consultar fuentes reales, lo que permite comprobar en
# clase que aportan las herramientas. Es mas lento y no admite herramientas
# propias. Basta con sustituir el valor de arriba por:
#   modelo = "groq/compound"

[aula]
# Contrasena opcional de clase. Dejar vacia para dejar la aplicacion abierta.
contrasena = ""
# Numero maximo de evaluaciones que puede lanzar un alumno en su sesion.
limite_evaluaciones = 5

# Herramienta de verificacion de hechos. Opcional: sin ella el agente funciona
# igual, pero escala a revision todo gasto cuya resolucion dependa de un hecho
# externo, porque no puede comprobarlo.
#
# La clave se obtiene en tavily.com, plan gratuito de 1.000 consultas al mes y
# sin tarjeta. Empieza por "tvly-".
[busqueda]
clave_api = ""
